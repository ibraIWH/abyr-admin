.muted { color: var(--muted); }
.nowrap { white-space: nowrap; }

/* Toolbar above tables */
.toolbar { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; flex-wrap: wrap; }
.search { position: relative; flex: 1; min-width: 200px; max-width: 360px; }
.search .input { padding-left: 12px; }
.seg { display: inline-flex; background: var(--cream); border-radius: 999px; padding: 3px; gap: 2px; }
.seg button {
  border: none; background: transparent; padding: 7px 14px; border-radius: 999px;
  font-size: 12.5px; font-weight: 500; color: var(--muted);
}
.seg button.is-active { background: var(--white); color: var(--ink); box-shadow: var(--shadow-sm); }

/* ============================ Loading / empty ============================ */
.spinner {
  display: inline-block; border-radius: 50%;
  border: 2.5px solid rgba(92,10,20,.15); border-top-color: var(--red);
  animation: spin .7s linear infinite;
}
.loading { display: flex; flex-direction: column; align-items: center; gap: 14px; padding: 60px 0; color: var(--muted); font-size: 14px; }

.empty { text-align: center; padding: 56px 24px; }
.empty__icon { color: var(--gold); margin-bottom: 14px; display: flex; justify-content: center; }
.empty__title { font-family: var(--display); font-style: italic; font-size: 24px; color: var(--ink); }
.empty__message { font-size: 14px; color: var(--muted); margin-top: 8px; max-width: 380px; margin-inline: auto; }
.empty__action { margin-top: 20px; display: flex; justify-content: center; }

/* ============================ Modal ============================ */
.modal-overlay {
  position: fixed; inset: 0; z-index: 60;
  background: rgba(26,26,26,.46);
  backdrop-filter: blur(3px);
  display: flex; align-items: flex-start; justify-content: center;
  padding: 48px 18px; overflow-y: auto;
  animation: fade .15s ease;
}
.modal {
  background: var(--white); border-radius: 16px; width: 100%; max-width: 560px;
  box-shadow: var(--shadow-md); animation: pop .18s ease;
}
.modal--wide { max-width: 880px; }
.modal__head {
  display: flex; align-items: flex-start; justify-content: space-between; gap: 16px;
  padding: 22px 26px; border-bottom: 1px solid var(--border);
}
.modal__title { font-family: var(--display); font-style: italic; font-weight: 400; font-size: 26px; color: var(--ink); }
.modal__subtitle { font-size: 13px; color: var(--muted); margin-top: 3px; }
.modal__body { padding: 24px 26px; }
.modal__foot { display: flex; justify-content: flex-end; gap: 10px; padding: 18px 26px; border-top: 1px solid var(--border); }
.confirm-text { font-size: 14.5px; color: #44403b; line-height: 1.6; }

.subhead {
  font-size: 11px; letter-spacing: 1.3px; text-transform: uppercase; color: var(--tan);
  font-weight: 700; margin: 4px 0 2px;
}
.divider { height: 1px; background: var(--border); border: none; margin: 4px 0; }

/* ============================ Image field ============================ */
.imagefield__row { display: flex; gap: 14px; align-items: stretch; }
.imagefield__preview {
  width: 92px; border-radius: var(--radius-sm); overflow: hidden;
  background: var(--cream); border: 1px solid var(--border);
  display: grid; place-items: center; flex-shrink: 0;
}
.imagefield__preview img { width: 100%; height: 100%; object-fit: cover; display: block; }
.imagefield__placeholder { color: #c4bbae; }
.imagefield__input { flex: 1; display: flex; flex-direction: column; gap: 7px; justify-content: center; }

/* Repeatable color rows */
.colorrow { display: grid; grid-template-columns: 1fr 116px 1fr 36px; gap: 10px; align-items: center; }
.swatch { width: 30px; height: 30px; border-radius: 7px; border: 1px solid var(--border); flex-shrink: 0; }
.color-input { display: flex; align-items: center; gap: 8px; }
.color-input input[type="color"] { width: 34px; height: 34px; border: 1px solid var(--border); border-radius: 7px; background: none; padding: 2px; cursor: pointer; }

/* ============================ Toast ============================ */
.toast-stack { position: fixed; bottom: 22px; right: 22px; z-index: 90; display: flex; flex-direction: column; gap: 10px; }
.toast {
  background: var(--white); color: var(--ink);
  border-left: 4px solid var(--tan);
  border-radius: 10px; box-shadow: var(--shadow-md);
  padding: 13px 18px; font-size: 13.5px; max-width: 340px;
  animation: slidein .25s ease; cursor: pointer;
}
.toast--success { border-left-color: var(--green); }
.toast--error { border-left-color: var(--red-alert); }
.toast--info { border-left-color: var(--gold); }

/* ============================ Login ============================ */
.login {
  min-height: 100vh; display: grid; place-items: center; padding: 24px;
  background:
    radial-gradient(1100px 540px at 12% -10%, rgba(92,10,20,.10), transparent 60%),
    radial-gradient(900px 480px at 110% 120%, rgba(196,168,130,.18), transparent 55%),
    var(--cream);
}
.login__card {
  width: 100%; max-width: 396px; background: var(--white);
  border: 1px solid var(--border); border-radius: 18px;
  box-shadow: var(--shadow-md); padding: 40px 36px;
}
.login__brand { text-align: center; margin-bottom: 26px; }
.login__mark { font-family: var(--display); font-style: italic; font-size: 44px; color: var(--red); line-height: 1; }
.login__sub { font-size: 10px; letter-spacing: 3px; color: var(--tan); font-weight: 500; margin-top: 6px; }
.login__title { font-family: var(--display); font-style: italic; font-size: 26px; text-align: center; margin-bottom: 4px; }
.login__hint { font-size: 13px; color: var(--muted); text-align: center; margin-bottom: 24px; }
.login__form { display: flex; flex-direction: column; gap: 16px; }
.login__error {
  background: #fbe7e7; color: #8d1f1f; border: 1px solid #f3cccc;
  border-radius: 9px; padding: 10px 13px; font-size: 13px;
}
.login__foot { margin-top: 18px; text-align: center; font-size: 12px; color: var(--muted); }

/* ============================ Animations ============================ */
@keyframes spin { to { transform: rotate(360deg); } }
@keyframes fade { from { opacity: 0; } to { opacity: 1; } }
@keyframes pop { from { opacity: 0; transform: translateY(8px) scale(.99); } to { opacity: 1; transform: none; } }
@keyframes slidein { from { opacity: 0; transform: translateX(16px); } to { opacity: 1; transform: none; } }

@media (prefers-reduced-motion: reduce) {
